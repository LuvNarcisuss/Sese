        "receiptID": {
          "path": [
            "receiptID"
          ],
          "type": "string",
          "required": true
        }
      },
      "action": "Remove only the acknowledged receipt from the current account and channel. This acknowledgement generates no reply."
    },
    {
      "key": "noticeSync",
      "name": "CommunityNoticeSync",
      "direction": "outbound",
      "discriminator": [
        "event"
      ],
      "template": {
        "event": "CommunityNoticeSync",
        "requestID": "sync-1",
        "protocolVersion": 1,
        "reason": "attached",
