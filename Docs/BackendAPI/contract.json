        },
        "supportedEvents": {
          "path": [
            "supportedEvents"
          ],
          "type": "array",
          "required": true
        }
      },
      "action": "Request replay of outstanding notices at attach, foreground and regular intervals. The server preserves original notice identity, content and expiration."
