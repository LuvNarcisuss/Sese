    },
    {
      "key": "shortsChanged",
      "direction": "inbound",
      "name": "CommunityShortsChanged",
      "discriminator": [
        "event"
      ],
      "template": {
        "event": "CommunityShortsChanged",
        "noticeID": "notice-1",
        "issuedAt": 1795564800000,
        "validUntil": 1795651200000
      },
      "bindings": {
        "noticeID": {
          "path": [
            "noticeID"
          ],
          "type": "string",
          "required": true
        },
        "issuedAt": {
          "path": [
            "issuedAt"
          ],
